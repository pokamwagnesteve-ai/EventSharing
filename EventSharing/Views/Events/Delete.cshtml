@model EventSharing.Models.Event
@{ ViewData["Title"] = "Supprimer l'événement"; }
<h1>Supprimer l'événement</h1>
<div class="alert alert-warning">Voulez-vous vraiment supprimer « @Model.Name » ?</div>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Annuler</a>
</form>