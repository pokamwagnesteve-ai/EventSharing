@model IEnumerable<EventSharing.Models.Event>
@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center">
    <h1 class="display-4">Partagez vos événements</h1>
    <p class="lead">Découvrez les événements de votre communauté et participez à ceux qui vous intéressent.</p>
    <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Voir les événements</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Events" asp-action="Create" class="btn btn-outline-primary">Créer un événement</a>
    }
</div>

<section class="mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Événements disponibles</h2>
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">Tout afficher</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Aucun événement enregistré pour le moment.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <span class="badge text-bg-primary align-self-start">@eventItem.Category.Name</span>
                            <h3 class="h5 mt-3">@eventItem.Name</h3>
                            <p class="text-muted mb-2">
                                @eventItem.StartDate.ToString("dd/MM/yyyy HH:mm") – @eventItem.EndDate.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            <p class="card-text flex-grow-1">
                                @(eventItem.Description.Length > 120 ? eventItem.Description[..120] + "…" : eventItem.Description)
                            </p>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@eventItem.Id" class="btn btn-primary">Voir le détail</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
