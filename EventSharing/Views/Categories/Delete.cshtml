@model EventSharing.Models.Category
@{ ViewData["Title"] = "Supprimer une catégorie"; }<h1>Supprimer une catégorie</h1>@if (Model.Events.Count > 0) { <div class="alert alert-warning">Cette catégorie est utilisée par @Model.Events.Count événement(s) et ne peut pas être supprimée.</div> } else { <div class="alert alert-warning">Voulez-vous supprimer « @Model.Name » ?</div><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><button class="btn btn-danger">Supprimer</button></form> }<a asp-action="Index" class="btn btn-secondary mt-2">Retour</a>